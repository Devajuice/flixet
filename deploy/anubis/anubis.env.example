# Example environment for Anubis (DO NOT commit real secrets)
# Copy to anubis.env (or inject via your secret manager) and fill in values.

# Upstream app origin reachable from Anubis
TARGET=http://app:3000

# Listen address inside the container/host
BIND=:8923
BIND_NETWORK=tcp

# Required: signing key for challenges/tokens (hex). Generate and keep secret.
# openssl rand -hex 32
ED25519_PRIVATE_KEY_HEX=REPLACE_WITH_GENERATED_HEX_KEY

# Optional tuning (see Anubis docs for your version)
# DIFFICULTY=4
# SERVE_ROBOTS_TXT=true
# POLICY_FNAME=/data/botPolicy.yaml
# OG_PASSTHROUGH=true

# Public/base URL if required by your deployment/version
# REDIRECT_DOMAINS=example.com
# PUBLIC_URL=https://example.com
