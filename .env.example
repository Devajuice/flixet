# TMDb API Key (server-side, used by the /api/tmdb proxy)
TMDB_API_KEY=your_api_key_here

# Legacy client-side key. Only needed if you still fetch TMDB directly from
# the browser; prefer TMDB_API_KEY above so the key isn't in the bundle.
NEXT_PUBLIC_TMDB_API_KEY=your_api_key_here

# OMDB API Key (optional - for episode-level ratings)
NEXT_PUBLIC_OMDB_API_KEY=your_omdb_api_key_here

# TMDb region for watch providers (e.g. IN, US, GB)
NEXT_PUBLIC_TMDB_REGION=IN

# Site URL (update this when deployed)
NEXT_PUBLIC_SITE_URL=https://yourdomain.vercel.app
